# Supabase Config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend Config (Shared Domain Emails & Inbound Webhooks)
RESEND_API_KEY=re_your_api_key
RESEND_WEBHOOK_SECRET=whsec_your_secret
SHARED_EMAIL_DOMAIN=team.yourdomain.com

# Daily.co Config (WebRTC Video Calling)
NEXT_PUBLIC_DAILY_DOMAIN=yourdomain.daily.co
DAILY_API_KEY=your_daily_api_key
NEXT_PUBLIC_DAILY_ROOM_NAME=team-general-room

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
